{
  "name": "books",
  "version": "0.1.0",
  "description": "书报 - 电子书阅读应用",
  "scripts": {
    "build": "python main.py",
    "encrypt:app-update": "python encrypt_app_update.py",
    "restore:app-update": "python encrypt_app_update.py --restore",
    "cap:init": "npx cap init",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "android:build": "npm run build && npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:dev": "npm run build && npm run cap:sync && npm run cap:open",
    "test:ui": "node --test tests/ui/test-*.js"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/status-bar": "^6.0.3",
    "@capawesome/capacitor-file-picker": "^6.2.0",
    "@xmldom/xmldom": "^0.9.10",
    "jszip": "^3.10.1",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "javascript-obfuscator": "^4.1.0",
    "jsdom": "^25.0.1"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhao-zg/books.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/zhao-zg/books/issues"
  },
  "homepage": "https://github.com/zhao-zg/books#readme"
}
